# RemindIt platform environment — the single env source for ALL modules
# (docs/ROADMAP.md §5, decision D9). Copy to `.env` (gitignored) and fill in;
# production secrets come from the VPS environment, never from the repo.

# --- bff (phase 1+) ---
# Hono (Bun.serve) port
PORT=3100
# PocketBase internal URL — bound to 127.0.0.1, never public
POCKETBASE_URL=http://127.0.0.1:8090
# PocketBase data dir (relative to the repo root; gitignored)
POCKETBASE_DATA_DIR=bff/pb_data
# Pin the PocketBase version via @fadlee/pocketbase-bin (empty = latest)
POCKETBASE_VERSION=0.40.1
# Superuser credentials — DEV ONLY (migrations + pocketbase-mcp);
# production superusers are provisioned on the VPS
POCKETBASE_ADMIN_EMAIL=dev-admin@remindit.local
POCKETBASE_ADMIN_PASSWORD=change-me-dev-only
# Dedicated dashboard-viewer superuser (PocketBase admin UI, /_/) — kept
# separate from the automation account above. PB has no read-only dashboard
# role (any `/_/` login is a full superuser), so generate a fresh password
# locally (openssl rand -base64 24) and treat the account as view-by-convention.
POCKETBASE_DASHBOARD_EMAIL=dev-viewer@remindit.local
POCKETBASE_DASHBOARD_PASSWORD=change-me-dev-only
# Session cookie Secure attribute — set true in production (TLS behind the
# reverse proxy); dev http://localhost keeps it false
SESSION_COOKIE_SECURE=false
# Password used by integration tests when registering throwaway PB users
TEST_PASSWORD=secret12345
# CORS origin allowlist (comma-separated) — the BFF answers preflights only
# for these browser origins (frontends live on other ports/subdomains).
# Defaults cover local dev when unset; production sets the real origins.
#CORS_ORIGINS=http://localhost:3000,http://localhost:3200,http://localhost:3300

# --- clients: pwa / web / admin (phases 4-5) ---
# Public BFF base URL (PB SDK baseUrl + Hono /api endpoints).
# Dev default: http://localhost:3100  |  Production: https://bff.remindit.localhost
PUBLIC_BFF_URL=http://localhost:3100
# web (marketing site): dev server port (rsbuild)
WEB_PORT=3200
# web download CTA target — the PWA origin.
# Dev default: http://localhost:3000  |  Production: https://pwa.remindit.localhost
PUBLIC_PWA_URL=http://localhost:3000
# Feedback (Apache Answer) public URL — footer links in pwa + web; the BFF
# also uses it to build the public question URL returned by POST /api/feedback.
# web renders the link only when set (never a localhost fallback in prod).
# Dev default: http://localhost:5555  |  Production: https://feedback.remindit.localhost
PUBLIC_FEEDBACK_URL=http://localhost:5555
#
# Local Caddy HTTPS workflow (docs/CADDY-LOCAL.md) — optional overrides.
# With the brew-services Caddy running (https://*.remindit.localhost ->
# localhost:{3000,3100,3200,3300}), set these instead so HTTPS pages can call
# the BFF and cookies mirror production. PUBLIC_BFF_URL stays https for BOTH
# workflows (an https fetch from an http://localhost page is not mixed
# content), and the CORS list covers all six origins so direct-port URLs keep
# working too. Restart the dev servers after changing any of these.
#
# PUBLIC_BFF_URL=https://bff.remindit.localhost
# PUBLIC_PWA_URL=https://pwa.remindit.localhost
# PUBLIC_FEEDBACK_URL=https://feedback.remindit.localhost
# CORS_ORIGINS=https://pwa.remindit.localhost,https://web.remindit.localhost,https://admin.remindit.localhost,http://localhost:3000,http://localhost:3200,http://localhost:3300
# SESSION_COOKIE_SECURE=true

# --- production (VPS, remindit.me) ---
# The VPS repo-root .env is the source of truth for prod (D9); these example
# values show the real subdomain shape. See docs/DEPLOY-VPS.md.
# Secure cookies behind the Caddy TLS terminator:
SESSION_COOKIE_SECURE=true
# CORS allowlist with the real production origins (D3):
CORS_ORIGINS=https://remindit.me,https://www.remindit.me,https://admin.remindit.me
# Public BFF base URL (PB SDK baseUrl + Hono /api). Build-time for the pwa;
# runtime for web/admin server functions:
PUBLIC_BFF_URL=https://api.remindit.me
# PWA origin (download CTA in web):
PUBLIC_PWA_URL=https://remindit.me
# Feedback (Apache Answer) public URL — footer links in pwa + web. Set because
# the feedback module is deployed as part of the platform (Phase D/D5); the
# links stay hidden only if this is unset (no localhost fallback in prod):
PUBLIC_FEEDBACK_URL=https://feedback.remindit.me

# --- pwa (existing, build-time) ---
# Rsbuild inlines PUBLIC_* at build time (import.meta.env) — restart the dev
# server or rebuild after changing a value.
# Seed-dataset selector used as onboarding fallback; valid ids (seed/index.ts):
#   minimal, items_categories, leo_romanian, rick_morty
PUBLIC_DATASET=items_categories
# Seed a simulated 6-month shopping history on first run (0 disables it).
PUBLIC_SEED_HISTORY=1
# admin (phase 6): dev server port (rsbuild)
ADMIN_PORT=3300

# --- feedback (Apache Answer Q&A, single binary on :5555) ---
# HTTP port (server.http.addr in feedback/answer-data/conf/config.yaml)
FEEDBACK_PORT=5555
# Pinned release tag (without the v prefix; empty = latest GitHub release)
FEEDBACK_VERSION=2.0.2
# Site identity + auto-install admin (first boot; docs/FEEDBACK.md)
FEEDBACK_SITE_NAME=RemindIt Feedback
FEEDBACK_SITE_URL=https://feedback.remindit.localhost
FEEDBACK_CONTACT_EMAIL=feedback-admin@remindit.local
FEEDBACK_ADMIN_NAME=remindit_admin
FEEDBACK_ADMIN_EMAIL=feedback-admin@remindit.local
FEEDBACK_ADMIN_PASSWORD=change-me-dev-only
# BFF → Answer admin API credentials (user bridge, one-way). The BFF logs in
# as this admin to provision app users in Answer at registration time.
ANSWER_INTERNAL_URL=http://127.0.0.1:5555
ANSWER_ADMIN_NAME=remindit_admin
ANSWER_ADMIN_EMAIL=feedback-admin@remindit.local
ANSWER_ADMIN_PASSWORD=change-me-dev-only
# Secret for deriving deterministic per-user Answer passwords (HMAC-SHA256,
# services/feedback.ts). DEV ONLY value — set a strong random one in prod
# (openssl rand -base64 32); the BFF refuses to boot without it in production.
ANSWER_BRIDGE_SECRET=dev-bridge-secret-change-me
# Fixed identity for the shared anonymous guest twin (web feedback, no PB
# linkage) — used by POST /api/feedback/guest.
#ANSWER_GUEST_EMAIL=feedback-guest@remindit.local

# --- smtp (bff configure script: `bun run configure:feedback smtp`) ---
# Configures the Answer sidecar's outbound mail. Dev default below is the
# Inbucket email-testing service (accepts any address, no auth, no TLS) —
# view received mail in the Inbucket web UI. Production needs a real provider
# and the script errors unless SMTP_HOST and SMTP_FROM are set.
SMTP_HOST=maildev.parsedw.ink
SMTP_PORT=2500
#SMTP_USER=
#SMTP_PASSWORD=
SMTP_FROM=feedback@remindit.local
SMTP_FROM_NAME=RemindIt Feedback
# "" = no encryption, "SSL", or "TLS"
SMTP_ENCRYPTION=
#SMTP_TEST_EMAIL=feedback-admin@remindit.local

# --- Scaleway Object Storage (off-box backups via rclone, D11) ---
# rclone remotes are built from these at runtime (no rclone.conf needed);
# backup.sh mirrors the local backup dirs to s3.<SCW_REGION>.scw.cloud.
# Generate keys in the Scaleway console (Project → Credentials); the secret
# must never be committed.
SCW_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXX
SCW_SECRET_KEY=change-me-scaleway-secret-key
SCW_REGION=nl-ams
SCW_BUCKET=remindit-backups
