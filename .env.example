# RemindIt platform environment — the single env source for ALL modules
# (docs/ROADMAP.md §5, decision D9). Copy to `.env` (gitignored) and fill in;
# production secrets come from the VPS environment, never from the repo.

# --- bff (phase 1+) ---
# Hono (Bun.serve) port
PORT=3100
# PocketBase internal URL — bound to 127.0.0.1, never public
POCKETBASE_URL=http://127.0.0.1:8090
# PocketBase data dir (relative to the repo root; gitignored)
POCKETBASE_DATA_DIR=bff/pb_data
# Pin the PocketBase version via @fadlee/pocketbase-bin (empty = latest)
POCKETBASE_VERSION=0.40.1
# Superuser credentials — DEV ONLY (migrations + pocketbase-mcp);
# production superusers are provisioned on the VPS
POCKETBASE_ADMIN_EMAIL=dev-admin@remindit.local
POCKETBASE_ADMIN_PASSWORD=change-me-dev-only
# Dedicated dashboard-viewer superuser (PocketBase admin UI, /_/) — kept
# separate from the automation account above. PB has no read-only dashboard
# role (any `/_/` login is a full superuser), so generate a fresh password
# locally (openssl rand -base64 24) and treat the account as view-by-convention.
POCKETBASE_DASHBOARD_EMAIL=dev-viewer@remindit.local
POCKETBASE_DASHBOARD_PASSWORD=change-me-dev-only
# Session cookie Secure attribute — set true in production (TLS behind the
# reverse proxy); dev http://localhost keeps it false
SESSION_COOKIE_SECURE=false
# Password used by integration tests when registering throwaway PB users
TEST_PASSWORD=secret12345
# CORS origin allowlist (comma-separated) — the BFF answers preflights only
# for these browser origins (frontends live on other ports/subdomains).
# Defaults cover local dev when unset; production sets the real origins.
#CORS_ORIGINS=http://localhost:3000,http://localhost:3200,http://localhost:3300

# --- clients: pwa / web / admin (phases 4-5) ---
# Public BFF base URL (PB SDK baseUrl + Hono /api endpoints)
PUBLIC_BFF_URL=http://localhost:3100
# web (marketing site): dev server port (rsbuild)
WEB_PORT=3200
# web download CTA target — the PWA origin
PUBLIC_PWA_URL=http://localhost:3000
#
# Local Caddy HTTPS workflow (docs/CADDY-LOCAL.md) — optional overrides.
# With the brew-services Caddy running (https://*.remindit.localhost ->
# localhost:{3000,3100,3200,3300}), set these instead so HTTPS pages can call
# the BFF and cookies mirror production. PUBLIC_BFF_URL stays https for BOTH
# workflows (an https fetch from an http://localhost page is not mixed
# content), and the CORS list covers all six origins so direct-port URLs keep
# working too. Restart the dev servers after changing any of these.
#
# PUBLIC_BFF_URL=https://bff.remindit.localhost
# PUBLIC_PWA_URL=https://pwa.remindit.localhost
# CORS_ORIGINS=https://pwa.remindit.localhost,https://web.remindit.localhost,https://admin.remindit.localhost,http://localhost:3000,http://localhost:3200,http://localhost:3300
# SESSION_COOKIE_SECURE=true

# --- pwa (existing, build-time) ---
# Rsbuild inlines PUBLIC_* at build time (import.meta.env) — restart the dev
# server or rebuild after changing a value.
# Seed-dataset selector used as onboarding fallback; valid ids (seed/index.ts):
#   minimal, items_categories, leo_romanian, rick_morty
PUBLIC_DATASET=items_categories
# Seed a simulated 6-month shopping history on first run (0 disables it).
PUBLIC_SEED_HISTORY=1
# admin (phase 6): dev server port (rsbuild)
ADMIN_PORT=3300
