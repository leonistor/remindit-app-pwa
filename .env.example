# Committed template of the env vars consumed at build/serve time.
# Copy to `.env` (gitignored) to override — e.g. switch the sample dataset:
#   PUBLIC_DATASET=rick_morty
#
# Valid dataset ids (see seed/index.ts > DATASETS):
#   items_categories, leo_romanian, rick_morty
#
# NOTE: Rsbuild inlines env vars at build time, so restart the dev server
# (or rebuild) after changing a value.
PUBLIC_DATASET=items_categories
