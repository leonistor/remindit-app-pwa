{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["*/AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "skill": { "*": "allow" }
  },
  "mcp": {
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "bunx",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium"
      ]
    },
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "chrome-devtools-mcp@latest"]
    },
    // PocketBase agent ops (gaspechak-pocketbase-mcp) — enable while working
    // on bff/. The wrapper injects PB_URL + dev superuser creds from the root
    // .env (never hardcoded here); requires `bun run dev:bff` (or a running
    // PB) and POCKETBASE_ADMIN_* set in the root .env.
    "pocketbase": {
      "enabled": true,
      "type": "local",
      "command": ["bun", "bff/scripts/pocketbase-mcp.ts"]
    }
  }
}
