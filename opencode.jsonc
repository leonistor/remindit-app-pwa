{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["*/AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "skill": { "*": "allow" }
  },
  "mcp": {
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "bunx",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium"
      ]
    },
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "chrome-devtools-mcp@latest"]
    },
    "crawlberg": {
      "enabled": false,
      "type": "local",
      "command": ["crawlberg", "mcp"]
    },
    "ark-ui": {
      "enabled": false,
      "type": "local",
      "command": ["bunx", "-y", "@ark-ui/mcp"]
    }
  }
}
