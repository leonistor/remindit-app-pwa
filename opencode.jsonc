{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["*/AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "skill": { "*": "allow" }
  },
  "mcp": {
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "bunx",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium"
      ]
    },
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": ["bunx", "-y", "chrome-devtools-mcp@latest"]
    },
    // PocketBase agent ops (gaspechak-pocketbase-mcp) — enable while working
    // on bff/. The wrapper loads the root .env (Bun auto-loads it) and injects
    // PB_URL + dev superuser creds into the MCP server process; requires
    // `bun run dev:bff` (or a running PB) and POCKETBASE_ADMIN_* in .env.
    // `bun --bun` forces Bun runtime (opencode itself is Node).
    "pocketbase": {
      "enabled": true,
      "type": "local",
      "command": ["bun", "--bun", "bff/scripts/pocketbase-mcp.ts"]
    }
  }
}
