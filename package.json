{
  "name": "remindit-monorepo",
  "private": true,
  "workspaces": [
    "common",
    "pwa",
    "bff",
    "web",
    "admin"
  ],
  "scripts": {
    "build": "cd pwa && bun --env-file=../.env run build",
    "caddy:reload": "caddy reload --config /opt/homebrew/etc/Caddyfile",
    "check": "cd pwa && bun run check",
    "deploy": "cd pwa && bun run deploy",
    "dev": "bun run dev:pwa",
    "dev:pwa": "cd pwa && bun --env-file=../.env run dev",
    "dev:bff": "cd bff && bun --env-file=../.env run dev",
    "dev:web": "cd web && bun --env-file=../.env run dev",
    "dev:all": "concurrently --kill-others -n pwa,bff,web,admin -c blue,green,magenta,yellow \"bun run dev:pwa\" \"bun run dev:bff\" \"bun run dev:web\" \"bun run dev:admin\"",
    "build:web": "cd web && bun --env-file=../.env run build",
    "migrate:bff": "cd bff && bun --env-file=../.env run migrate",
    "test:bff": "cd bff && bun --env-file=../.env test",
    "demos": "cd pwa && bun run demos",
    "format": "cd pwa && bun run format",
    "generate:palettes": "cd pwa && bun run generate:palettes",
    "i18n:compile": "cd pwa && bun run i18n:compile",
    "lint": "cd pwa && bun run lint",
    "preview": "cd pwa && bun run preview",
    "screenshot:gallery": "cd pwa && bun run screenshot:gallery",
    "screenshot:mobile": "cd pwa && bun run screenshot:mobile",
    "test": "cd pwa && bun run test",
    "test:changed": "cd pwa && bun run test:changed",
    "test:e2e": "cd pwa && bun run test:e2e",
    "test:e2e:prod": "cd pwa && bun run test:e2e:prod",
    "test:pre": "cd pwa && bun run test:pre",
    "test:quick": "cd pwa && bun run test:quick",
    "test:watch": "cd pwa && bun run test:watch",
    "typecheck": "cd pwa && bun run typecheck && cd ../common && bun run typecheck && cd ../bff && bun run typecheck && cd ../web && bun run typecheck && cd ../admin && bun run typecheck",
    "dev:admin": "cd admin && bun --env-file=../.env run dev",
    "build:admin": "cd admin && bun --env-file=../.env run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
