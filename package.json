{
  "name": "remindit-monorepo",
  "private": true,
  "workspaces": [
    "common",
    "pwa",
    "bff",
    "web",
    "admin",
    "feedback"
  ],
  "scripts": {
    "build": "cd pwa && bun --env-file=../.env run build",
    "caddy:reload": "caddy reload --config /opt/homebrew/etc/Caddyfile",
    "check": "cd pwa && bun run check",
    "deploy": "cd pwa && bun run deploy",
    "dev": "bun run dev:pwa",
    "dev:pwa": "cd pwa && bun --env-file=../.env run dev",
    "dev:bff": "cd bff && bun --env-file=../.env run dev",
    "dev:web": "cd web && bun --env-file=../.env run dev",
    "dev:all": "concurrently --kill-others -n pwa,bff,web,admin,feedback -c blue,green,magenta,yellow,cyan \"bun run dev:pwa\" \"bun run dev:bff\" \"bun run dev:web\" \"bun run dev:admin\" \"bun run dev:feedback\"",
    "build:web": "cd web && bun --env-file=../.env run build",
    "migrate:bff": "cd bff && bun --env-file=../.env run migrate",
    "backfill:feedback": "cd bff && bun --env-file=../.env run backfill:feedback",
    "seed:bff": "cd bff && bun --env-file=../.env run seed",
    "configure:feedback": "cd bff && bun --env-file=../.env run configure:feedback",
    "test:bff": "cd bff && FEEDBACK_BRIDGE=off AUTH_RATE_LIMIT=10000 bun --env-file=../.env test",
    "demos": "cd pwa && bun run demos",
    "format": "cd pwa && bun run format",
    "generate:palettes": "cd pwa && bun run generate:palettes",
    "i18n:compile": "cd pwa && bun run i18n:compile && cd ../web && bun run i18n:compile",
    "i18n:check": "cd pwa && bun run i18n:check",
    "kickstart:locale": "cd common && bun run kickstart:locale",
    "lint": "cd pwa && bun run lint",
    "preview": "cd pwa && bun run preview",
    "screenshot:gallery": "cd pwa && bun run screenshot:gallery",
    "screenshot:mobile": "cd pwa && bun run screenshot:mobile",
    "test": "cd pwa && bun run test",
    "test:changed": "cd pwa && bun run test:changed",
    "test:e2e": "cd pwa && bun run test:e2e",
    "test:e2e:prod": "cd pwa && bun run test:e2e:prod",
    "test:pre": "cd pwa && bun run test:pre",
    "test:quick": "cd pwa && bun run test:quick",
    "test:watch": "cd pwa && bun run test:watch",
    "typecheck": "cd pwa && bun run typecheck && cd ../common && bun run typecheck && cd ../bff && bun run typecheck && cd ../web && bun run typecheck && cd ../admin && bun run typecheck && cd ../feedback && bun run typecheck",
    "dev:admin": "cd admin && bun --env-file=../.env run dev",
    "build:admin": "cd admin && bun --env-file=../.env run build",
    "setup:feedback": "cd feedback && bun --env-file=../.env run setup",
    "dev:feedback": "cd feedback && bun --env-file=../.env run start",
    "stop:feedback": "cd feedback && bun --env-file=../.env run stop",
    "preview:web": "cd web && bun --env-file=../.env run preview",
    "preview:admin": "cd admin && bun --env-file=../.env run preview"
  },
  "devDependencies": {
    "bm2": "1.1.0",
    "concurrently": "^10.0.5"
  }
}
